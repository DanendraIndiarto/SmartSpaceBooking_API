    {
      "name": "2. Autentikasi Pengguna (Member & Admin Space)",
      "item": [
        {
          "name": "3. POST /api/auth/register/member - Registrasi Member Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('member_token', res.data.access_token);",
                  "    pm.environment.set('member_token', res.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"Secret123!\",\n  \"nama_member\": \"John Doe\",\n  \"instansi\": \"Universitas Indonesia / PT Maju Mundur\",\n  \"alamat\": \"Jl. Sudirman No. 123, Jakarta Selatan\",\n  \"telp\": \"081234567890\",\n  \"foto\": \"member_john.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/member"
            }
          }
        },
        {
          "name": "4. POST /api/auth/register/admin-space - Registrasi Admin Space",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('admin_token', res.data.access_token);",
                  "    pm.environment.set('admin_token', res.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_space1\",\n  \"password\": \"Admin123!\",\n  \"nama_coworking\": \"Moklet Hub Coworking\",\n  \"nama_pemilik\": \"Ahmad Bidin\",\n  \"telp\": \"081298765432\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/admin-space"
            }
          }
        },
        {
          "name": "5. POST /api/auth/login - Login User (Member / Admin Space)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    if (res.data.role === 'admin_space') {",
                  "        pm.collectionVariables.set('admin_token', res.data.access_token);",
                  "        pm.environment.set('admin_token', res.data.access_token);",
                  "    } else {",
                  "        pm.collectionVariables.set('member_token', res.data.access_token);",
                  "        pm.environment.set('member_token', res.data.access_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login"
            }
          }
        },
        {
          "name": "6. GET /api/auth/profile - Cek Profil Pengguna Login",
